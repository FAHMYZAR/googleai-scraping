[Unit]
Description=Bun API Fahmyzzx Service with Xvfb
After=network.target

[Service]
Type=simple
User=fahmyzzx
WorkingDirectory=/home/fahmyzzx/api-fahmyzzx
Environment=PATH=/home/fahmyzzx/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=PORT=9876
Environment=PROVIDER_API_KEY=sk-gai-local-secret
ExecStart=/usr/bin/xvfb-run -a bun run src/index.ts
Restart=on-failure

[Install]
WantedBy=multi-user.target
