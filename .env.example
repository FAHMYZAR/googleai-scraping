# ============================================
# api-fahmyzzx - Environment Variables
# ============================================
# Salin ke .env untuk development lokal.
# Untuk Portainer, set variable ini langsung di Stack Env.

# Kunci API untuk endpoint /v1/*
PROVIDER_API_KEY=sk-gai-local-secret

# JSON string dari cookies Google AI Mode (format Cookie-Editor)
# Penting! Bungkus dengan tanda kutip tunggal di Portainer.
GOOGLE_COOKIES_JSON=

# Base64 dari file moodle_uaa_cookies.pkl (tanpa newline)
# Opsional, hanya untuk endpoint Moodle.
MOODLE_UAA_COOKIES_PKL_B64=
